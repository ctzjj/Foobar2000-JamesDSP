    LTEXT            "+0.0",  IDC_STATIC_EQ_BANDVAL0 + 8, 362, 164, 34, 8
    CONTROL          "",     IDC_SLIDER_EQ_BAND0 + 8, "msctls_trackbar32", TBS_VERT | TBS_NOTICKS, 369, 176, 20, 68
    LTEXT            "8k",    IDC_STATIC_EQ_BANDFREQ0 + 8, 364, 250, 30, 8
    LTEXT            "+0.0",  IDC_STATIC_EQ_BANDVAL0 + 9, 406, 164, 34, 8
    CONTROL          "",     IDC_SLIDER_EQ_BAND0 + 9, "msctls_trackbar32", TBS_VERT | TBS_NOTICKS, 413, 176, 20, 68
    LTEXT            "16k",   IDC_STATIC_EQ_BANDFREQ0 + 9, 408, 250, 30, 8
    LTEXT            "Band:",               IDL_EQ_BAND,       10, 274, 26, 8
    COMBOBOX         IDC_COMBO_EQ_BAND,     38, 272, 55, 80, CBS_DROPDOWNLIST | WS_VSCROLL
    LTEXT            "Freq:",               IDL_EQ_FREQ,       100, 274, 24, 8
    EDITTEXT         IDC_EDIT_EQ_FREQ,      126, 272, 45, 13, ES_AUTOHSCROLL
