    CONTROL          "",                     IDC_SLIDER_CONV_GAIN, "msctls_trackbar32", TBS_NOTICKS | TBS_HORZ, 80, 128, 300, 14
    LTEXT            "0 dB",                 IDC_STATIC_CONV_GAIN,    385, 130, 60, 10
END

IDD_TAB_SCRIPT DIALOGEX 0, 0, 470, 310
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_BORDER
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    AUTOCHECKBOX     "Enable EEL2 Scripting", IDC_CHK_SCRIPT_ENABLE, 10, 10, 200, 10
    LTEXT            "Script:",              IDL_SC_SCRIPT,       10, 28, 30, 10
    EDITTEXT         IDC_EDIT_SCRIPT,                            10, 42, 450, 230, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_HSCROLL
    PUSHBUTTON       "Load Script...",       IDC_BTN_SCRIPT_LOAD,  10, 278, 80, 14
    PUSHBUTTON       "Save Script...",       IDC_BTN_SCRIPT_SAVE,  95, 278, 80, 14
    LTEXT            "Status: Ready",        IDL_SC_STATUS, 200, 280, 260, 10
END
