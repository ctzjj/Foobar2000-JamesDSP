IDD_TAB_DYNAMICS DIALOGEX 0, 0, 470, 310
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_BORDER
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX         "Compressor",           IDL_DYN_COMP_GRP,      10, 10, 450, 100
    AUTOCHECKBOX     "Enable",               IDC_CHK_COMP,          20, 25, 100, 10
    LTEXT            "Threshold (dB):",      IDL_DYN_COMP_THRESH,   20, 42, 60, 10
    CONTROL          "",                     IDC_SLIDER_COMP_THRESH, "msctls_trackbar32", TBS_NOTICKS | TBS_HORZ, 85, 40, 200, 14
    LTEXT            "-20",                  IDC_STATIC_COMP_THRESH,    290, 42, 50, 10
    LTEXT            "Ratio:",               IDL_DYN_COMP_RATIO,    20, 60, 40, 10
    CONTROL          "",                     IDC_SLIDER_COMP_RATIO, "msctls_trackbar32", TBS_NOTICKS | TBS_HORZ, 85, 58, 200, 14
    LTEXT            "4:1",                  IDC_STATIC_COMP_RATIO,     290, 60, 50, 10
    LTEXT            "Attack (ms):",         IDL_DYN_COMP_ATTACK,   20, 78, 55, 10
    CONTROL          "",                     IDC_SLIDER_COMP_ATTACK, "msctls_trackbar32", TBS_NOTICKS | TBS_HORZ, 85, 76, 200, 14
    LTEXT            "5",                    IDC_STATIC_COMP_ATTACK,    290, 78, 50, 10
    LTEXT            "Release (ms):",        IDL_DYN_COMP_RELEASE,  20, 96, 55, 10
    CONTROL          "",                     IDC_SLIDER_COMP_RELEASE, "msctls_trackbar32", TBS_NOTICKS | TBS_HORZ, 85, 94, 200, 14
    LTEXT            "50",                   IDC_STATIC_COMP_RELEASE,   290, 96, 50, 10
    GROUPBOX         "Limiter",              IDL_DYN_LIM_GRP,       10, 115, 450, 65
    AUTOCHECKBOX     "Enable",               IDC_CHK_LIM,           20, 130, 100, 10
    LTEXT            "Threshold (dB):",      IDL_DYN_LIM_THRESH,    20, 148, 60, 10
    CONTROL          "",                     IDC_SLIDER_LIM_THRESH, "msctls_trackbar32", TBS_NOTICKS | TBS_HORZ, 85, 146, 200, 14
    LTEXT            "0",                    IDC_STATIC_LIM_THRESH,     290, 148, 50, 10
    LTEXT            "Release (ms):",        IDL_DYN_LIM_RELEASE,   20, 166, 55, 10
    CONTROL          "",                     IDC_SLIDER_LIM_RELEASE, "msctls_trackbar32", TBS_NOTICKS | TBS_HORZ, 85, 164, 200, 14
    LTEXT            "50",                   IDC_STATIC_LIM_RELEASE,    290, 166, 50, 10
    GROUPBOX         "DDC",                  IDL_DYN_DDC_GRP,       10, 185, 450, 80
    AUTOCHECKBOX     "Enable",               IDC_CHK_DDC_ENABLE,    20, 200, 100, 10
    LTEXT            "Strength:",            IDL_DYN_DDC_STRENGTH,  20, 218, 50, 10
    CONTROL          "",                     IDC_SLIDER_DDC_STRENGTH, "msctls_trackbar32", TBS_NOTICKS | TBS_HORZ, 85, 216, 200, 14
    LTEXT            "50%",                  IDC_STATIC_DDC_STRENGTH,   290, 218, 50, 10
    LTEXT            "Profile:",             IDL_DYN_DDC_PROFILE,   20, 240, 40, 10
    EDITTEXT         IDC_EDIT_DDC_PROFILE,                       65, 237, 330, 14, ES_AUTOHSCROLL
    PUSHBUTTON       "Browse...",            IDC_BTN_DDC_BROWSE,  400, 237, 50, 14
END

