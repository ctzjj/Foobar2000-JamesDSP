IDD_TAB_CONVOLVER DIALOGEX 0, 0, 470, 310
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_BORDER
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    AUTOCHECKBOX     "Enable Convolver",     IDC_CHK_CONV_ENABLE, 10, 10, 200, 10
