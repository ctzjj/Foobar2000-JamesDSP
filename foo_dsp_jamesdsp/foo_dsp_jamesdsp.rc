    AUTOCHECKBOX     "Reverb",               IDC_CHK_REVERB,       10, 118, 200, 10
    AUTOCHECKBOX     "Bass Boost",           IDC_CHK_BASS_BOOST,   10, 136, 200, 10
    AUTOCHECKBOX     "Stereo Widener",       IDC_CHK_STEREO,       10, 154, 200, 10
    AUTOCHECKBOX     "IIR Filters",          IDC_CHK_IIR,          10, 172, 200, 10
