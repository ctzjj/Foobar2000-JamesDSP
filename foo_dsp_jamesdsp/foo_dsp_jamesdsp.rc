#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDD_JDSP_CONFIG DIALOGEX 0, 0, 400, 300
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "JamesDSP Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK", IDOK, 290, 278, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 345, 278, 50, 14
    CONTROL         "", IDC_TAB_MAIN, WC_TABCONTROL, WS_TABSTOP, 7, 7, 386, 265
END
