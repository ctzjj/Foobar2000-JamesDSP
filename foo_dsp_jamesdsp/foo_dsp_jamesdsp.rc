    LTEXT            "+0.0",  IDC_STATIC_EQ_BANDVAL0 + 5, 230, 164, 34, 8
    CONTROL          "",     IDC_SLIDER_EQ_BAND0 + 5, "msctls_trackbar32", TBS_VERT | TBS_NOTICKS, 237, 176, 20, 68
