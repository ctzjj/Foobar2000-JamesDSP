#include <windows.h>
#include <commctrl.h>
#include "resource.h"

#ifndef TBS_NOTICKS
#define TBS_NOTICKS 0x0008
#endif
#ifndef TBS_HORZ
#define TBS_HORZ 0x0000
#endif
#ifndef TBS_VERT
#define TBS_VERT 0x0004
#endif

IDD_JDSP_CONFIG DIALOGEX 0, 0, 500, 370
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "JamesDSP Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_TAB_MAIN, WC_TABCONTROL, WS_TABSTOP, 7, 7, 486, 335
    PUSHBUTTON      "Save Config", IDC_BTN_SAVE_CONFIG, 80, 350, 60, 14
    PUSHBUTTON      "Load Config", IDC_BTN_LOAD_CONFIG, 145, 350, 60, 14
    PUSHBUTTON      "Reset All", IDC_BTN_RESET_ALL, 210, 350, 50, 14
    COMBOBOX        IDC_COMBO_LANGUAGE, 300, 350, 60, 60, CBS_DROPDOWNLIST | WS_VSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 380, 350, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 436, 350, 50, 14
END

